module mux2to1_tb;
  
  reg D0,D1,sel;
  wire y;
  
  mux2to1 DUT(.D0(D0),.D1(D1),.sel(sel),.y(y));
  initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0,mux2to1_tb );
    $display("sel=%b | D0=%b | D1=%b | Y=%b ",sel,D0,D1,y);
    
    sel=0; D0=1; D1=0; #5;
    sel=1; D0=0; D1=1; #5;
